{# A post on the list: its cover, its subjects, its title and preview. #}
<article class="blog-card">
    {% if post.cover %}<a class="blog-card-cover" href="{{ path('blog_post', {slug: post.slug}) }}"><img src="{{ post.cover }}" alt="" loading="lazy"></a>{% endif %}
    <div class="blog-card-body">
        <p class="blog-card-meta">{% include '@Blog/client/_meta.html.twig' %}</p>
        <h3><a href="{{ path('blog_post', {slug: post.slug}) }}">{{ post.title }}</a></h3>
        {% if post.excerpt %}<p>{{ post.excerpt|length > 180 ? post.excerpt|slice(0, 180) ~ '…' : post.excerpt }}</p>{% endif %}
    </div>
</article>
