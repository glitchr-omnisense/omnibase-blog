{# The line under a title (a Base\Screen\Card or Story, `card`; from a host page's own `post` entity, blog_card()): the date, the reading time, the taxa and tags as pills. #}{% set card = card ?? blog_card(post) %}
<time datetime="{{ card.publishedAt|date('c') }}">{{ card.publishedAt|format_date('long') }}</time>
<span aria-hidden="true">·</span> {{ '@blog.post.reading'|trans({minutes: card.readingMinutes}) }}
{% for taxon in card.taxa %}<a class="blog-pill is-taxon" href="{{ taxon.url }}">{{ taxon.label }}</a>{% endfor %}
{% for tag in card.tags %}<a class="blog-pill" href="{{ tag.url }}">{{ tag.label }}</a>{% endfor %}
