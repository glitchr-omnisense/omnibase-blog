<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
    <title>{{ screen.title }} — {{ '@blog.index.title'|trans }}</title>
    <link>{{ screen.indexUrl }}</link>
    <atom:link href="{{ screen.feedUrl }}" rel="self" type="application/rss+xml"/>
    <description>{{ '@blog.index.description'|trans }}</description>
    <language>{{ frame.locale }}</language>
    {% for item in screen.items %}
    <item>
        <title>{{ item.title }}</title>
        <link>{{ item.url }}</link>
        <guid isPermaLink="true">{{ item.url }}</guid>
        <pubDate>{{ item.publishedAt|date('r') }}</pubDate>
        <description>{{ (item.excerpt ?? item.headline ?? '')|escape }}</description>
    </item>
    {% endfor %}
</channel>
</rss>
