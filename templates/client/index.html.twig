{#
 # The chronicles, a page at a time (Base\Blog\Screen\BlogPage, `screen`): the
 # featured (or newest) post first and larger, then the cards, the topics to
 # filter by, the months of the archive. The host's layout1.html.twig gives the
 # chrome; blog.css the look.
 #}
{% extends 'layout1.html.twig' %}

{% block title %}{{ screen.month is not null ? '@blog.index.month_title'|trans({month: screen.month|format_datetime(pattern: 'LLLL yyyy')|capitalize}) : (screen.topic ? '@blog.index.topic_title'|trans({topic: screen.topic}) : '@blog.index.title'|trans) }}{% endblock %}
{% block description %}{{ '@blog.index.description'|trans }}{% endblock %}

{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('bundles/blog/css/blog.css') }}">{% endblock %}

{% block content %}
<section class="blog blog-index">
    <header class="blog-head">
        <div>
            <p class="blog-eyebrow">{{ '@blog.index.eyebrow'|trans }}</p>
            <h1>{{ screen.month is not null ? screen.month|format_datetime(pattern: 'LLLL yyyy')|capitalize : (screen.topic ? screen.topic : '@blog.index.title'|trans) }}</h1>
            <p class="blog-lead">{{ '@blog.index.lead'|trans }}</p>
        </div>
        <a class="blog-feed" href="{{ screen.links.feed }}" title="RSS"><i class="fa-solid fa-rss" aria-hidden="true"></i> RSS</a>
    </header>

    {% if screen.topics %}
    <nav class="blog-topics" aria-label="{{ '@blog.index.topics'|trans }}">
        <a href="{{ screen.links.index }}" {{ not screen.topic ? 'aria-current="page"' }}>{{ '@blog.index.all'|trans }}</a>
        {% for t in screen.topics %}<a href="{{ t.url }}" {{ t.current ? 'aria-current="page"' }}>{{ t.label }}</a>{% endfor %}
    </nav>
    {% endif %}

    {% if screen.headline %}{% set headline = screen.headline %}
    <article class="blog-card is-headline">
        {% if headline.cover is not null %}<a class="blog-card-cover" href="{{ headline.url }}"><img src="{{ headline.cover }}" alt="" loading="lazy"></a>{% endif %}
        <div class="blog-card-body">
            <p class="blog-card-meta">{% include '@Blog/client/_meta.html.twig' with {card: headline} %}</p>
            <h2><a href="{{ headline.url }}">{{ headline.title }}</a></h2>
            {% if headline.headline %}<p class="blog-card-headline">{{ headline.headline }}</p>{% endif %}
            {% if headline.excerpt %}<p>{{ headline.excerpt }}</p>{% endif %}
            <a class="blog-more" href="{{ headline.url }}">{{ '@blog.index.read'|trans }} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </div>
    </article>
    {% endif %}

    {% if screen.articles %}
    <div class="blog-grid">
        {% for card in screen.articles %}{% include '@Blog/client/_card.html.twig' %}{% endfor %}
    </div>
    {% elseif not screen.headline %}
    <p class="blog-empty">{{ '@blog.index.empty'|trans }}</p>
    {% endif %}

    {% if screen.pages > 1 %}
    <nav class="blog-pager" aria-label="{{ '@blog.index.pages'|trans }}">
        {% if screen.prev %}<a rel="prev" href="{{ screen.prev }}">‹ {{ '@blog.index.newer'|trans }}</a>{% endif %}
        <span>{{ screen.page }} / {{ screen.pages }}</span>
        {% if screen.next %}<a rel="next" href="{{ screen.next }}">{{ '@blog.index.older'|trans }} ›</a>{% endif %}
    </nav>
    {% endif %}

    {% if screen.months %}
    <aside class="blog-archive">
        <h2>{{ '@blog.index.archive'|trans }}</h2>
        {% for year in screen.months %}
        <p><strong>{{ year.year }}</strong>
            {% for m in year.months %}<a href="{{ m.url }}">{{ ('2000-' ~ m.month ~ '-01')|date('U')|format_datetime(pattern: 'LLLL')|capitalize }} <small>({{ m.count }})</small></a>{% endfor %}
        </p>
        {% endfor %}
    </aside>
    {% endif %}
</section>
{% endblock %}
