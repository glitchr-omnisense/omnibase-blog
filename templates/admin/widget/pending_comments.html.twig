{# The comments that wait for the moderator (Base\Blog\Admin\Widget\PendingCommentsWidgetType). #}
<div class="analytics-card card blog-pending">
    <div class="analytics-card-header">
        <h2 class="analytics-card-title">{{ widget.label|trans({}, 'admin') }}</h2>
    </div>
    <div class="blog-pending-body">
        <a class="blog-pending-count{{ pending > 0 ? ' is-waiting' }}" href="{{ path('admin_crud_comments_index', {filters: {state: 'pending'}}) }}">
            <strong>{{ pending }}</strong>
            <span>{{ '@blog.admin.widget.pending'|trans({count: pending}) }}</span>
        </a>
        {% if comments %}
        <ul class="blog-pending-list">
            {% for comment in comments %}
            <li><a href="{{ path('admin_crud_comments_detail', {entityId: comment.id}) }}"><b>{{ comment.displayName }}</b> · {{ comment.thread ? comment.thread.title : '@blog.book.title'|trans }}<br><small>{{ comment.content|length > 90 ? comment.content|slice(0, 90) ~ '…' : comment.content }}</small></a></li>
            {% endfor %}
        </ul>
        {% else %}
        <p class="blog-pending-empty">{{ '@blog.admin.widget.none'|trans }}</p>
        {% endif %}
    </div>
</div>
<style>
    .blog-pending-body { display: grid; gap: .75rem; padding: 0 1rem 1rem; }
    .blog-pending-count { display: grid; gap: .2rem; padding: .9rem 1rem; border-radius: .75rem; background: rgba(127,127,127,.08); color: inherit; text-decoration: none; }
    .blog-pending-count strong { font-size: 1.6rem; line-height: 1.1; }
    .blog-pending-count span { font-size: .8rem; opacity: .75; }
    .blog-pending-count.is-waiting { background: rgba(252,104,117,.16); }
    .blog-pending-count.is-waiting strong { color: #d9404e; }
    .blog-pending-list { margin: 0; padding: 0; list-style: none; display: grid; gap: .4rem; font-size: .85rem; }
    .blog-pending-list a { color: inherit; text-decoration: none; }
    .blog-pending-empty { margin: 0; font-size: .85rem; opacity: .7; }
</style>
