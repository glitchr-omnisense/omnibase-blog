{
    "name": "omnibase/blog",
    "description": "Chronicles and visitors' comments for omnibase: a Post is a Thread, a Comment is read by Akismet before it goes online.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "doctrine/orm": "^2.15|^3.0",
        "glitchr/omnibase": "3.0.*-dev",
        "league/flysystem": "^3.0",
        "omnibase/admin": "dev-main",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/console": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "symfony/http-client": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "symfony/security-bundle": "^6.0|^7.0|^8.0",
        "symfony/string": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "suggest": {
        "glitchr/ux-google": "Adds Google reCAPTCHA v3 to the comment form when google.recaptcha.enable is on."
    },
    "autoload": {
        "psr-4": {
            "Base\\Blog\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Base\\Blog\\Tests\\": "./tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
